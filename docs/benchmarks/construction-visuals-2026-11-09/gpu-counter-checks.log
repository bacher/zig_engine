# Ordinary-executable renderer counter correctness smoke checks.
# These short runs are NOT timing evidence; use gpu-sparse-results.log for the isolated sparse sweep.
# Every command exited 0 and ran 1 warmup + 3 measured frames, 1 repeat.
# Internal validation: explicit gate, disabled cumulative zeros, enabled positive builds/uploads,
# exact draw/uniform counts including warmup, exact live occupancy/chunks, clear/release balance.

# command: zig build bench-blueprint-visual-gpu -Doptimize=ReleaseFast -j2 -- --targets 32000 --scenario quarter_changed --frames 3 --warmup 1 --repeats 1
# exit_status=0
adapter=Apple M4 Max backend=metal optimize=ReleaseFast wrap_x=true
fixture=dense offscreen=256x256 counters_enabled=false frames=3 warmup=1 repeats=1 origin_offset_xyz=0; serialized completion fence each frame; no window/present; no world hash lookups, terrain, rails, UI, queue scheduling or deferred publication
pack=synthetic grouped target scan+coordinate packing; source=cache replace/upload calls; draw=production source/uniform uploads+encode+submit; completion=wall wait, NOT GPU timestamp; total=serialized component wall
sample fixture=dense targets=32000 chunks=12 offset=0 scenario=quarter_changed mode=dynamic repeat=0 cpu_p50_ms=0.1802 cpu_p95_ms=0.1802 total_p50_ms=2.2933 total_p95_ms=2.2933 checksum=bab87eee4fcb802b colored_pixels=8810
sample fixture=dense targets=32000 chunks=12 offset=0 scenario=quarter_changed mode=cached repeat=0 cpu_p50_ms=0.0735 cpu_p95_ms=0.0735 total_p50_ms=1.4449 total_p95_ms=1.4449 checksum=bab87eee4fcb802b colored_pixels=8810
